---
import { siteConfig } from '../config/site.ts';

export interface Props {
  slotId: string;
  label?: string;
}

const { slotId, label = 'Advertisement' } = Astro.props;
const enabled = Boolean(siteConfig.adsensePublisherId);
---

{
  enabled ? (
    <>
      <div class="ad-slot" data-enabled="true" aria-label={label}>
        <ins
          class="adsbygoogle"
          style="display:block"
          data-ad-client={siteConfig.adsensePublisherId}
          data-ad-slot={slotId}
          data-ad-format="auto"
          data-full-width-responsive="true"
        />
      </div>
      <script is:inline>
        (function () {
          try {
            (window.adsbygoogle = window.adsbygoogle || []).push({});
          } catch (e) {}
        })();
      </script>
    </>
  ) : null
}
