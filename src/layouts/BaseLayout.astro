---
import '../styles/global.css';
import { siteConfig, absoluteUrl } from '../config/site.ts';
import { tools } from '../data/tools.ts';
import { guides } from '../data/guides.ts';
import Breadcrumbs from '../components/Breadcrumbs.astro';

export interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  ogType?: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown>[];
  breadcrumbs?: { name: string; path: string }[];
  lastUpdated?: string;
  noindex?: boolean;
  /** Defer cookie banner until scroll/interaction (emergency pages) */
  deferCookieBanner?: boolean;
  /** Skip brand suffix when title already includes site name or is long */
  skipBrandSuffix?: boolean;
}

const {
  title,
  description = siteConfig.tagline,
  canonicalPath,
  ogType = 'website',
  ogImage = '/og-default.png',
  jsonLd = [],
  breadcrumbs,
  lastUpdated = siteConfig.buildDate,
  noindex = false,
  deferCookieBanner = false,
} = Astro.props;

function trailSlash(path: string): string {
  if (!path || path === '/') return '/';
  return path.endsWith('/') ? path : `${path}/`;
}

const pathname = trailSlash(Astro.url.pathname);
const canonical = absoluteUrl(trailSlash(canonicalPath ?? Astro.url.pathname));
const pageTitle =
  title.includes(siteConfig.siteName) || title.includes(`| ${siteConfig.brandName}`)
    ? title
    : `${title} | ${siteConfig.siteName}`;

const navLinks = [
  { href: '/tools/', label: 'Tools' },
  { href: '/dogs/', label: 'Dogs' },
  { href: '/cats/', label: 'Cats' },
  { href: '/guides/', label: 'Guides' },
  { href: '/about/', label: 'About' },
] as const;

const footerLegal = [
  { href: '/about/', label: 'About' },
  { href: '/methodology/', label: 'Methodology' },
  { href: '/editorial-policy/', label: 'Editorial policy' },
  { href: '/contact/', label: 'Contact' },
  { href: '/privacy/', label: 'Privacy' },
  { href: '/terms/', label: 'Terms' },
] as const;

const adsEnabled = Boolean(siteConfig.adsensePublisherId);
const ogImageAbs = absoluteUrl(ogImage);
const personUrl = absoluteUrl('/about/');

const defaultJsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': absoluteUrl('/#organization'),
    name: siteConfig.siteName,
    alternateName: siteConfig.brandName,
    url: absoluteUrl('/'),
    logo: {
      '@type': 'ImageObject',
      url: absoluteUrl('/logo-512.png'),
      width: 512,
      height: 512,
    },
    email: siteConfig.contactEmail,
    founder: { '@id': siteConfig.personId },
    publishingPrinciples: absoluteUrl('/editorial-policy/'),
    ...(siteConfig.sameAs.length ? { sameAs: siteConfig.sameAs } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': absoluteUrl('/#website'),
    name: siteConfig.siteName,
    alternateName: [siteConfig.brandName],
    url: absoluteUrl('/'),
    description: siteConfig.tagline,
    inLanguage: 'en-US',
    publisher: { '@id': absoluteUrl('/#organization') },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': siteConfig.personId,
    name: siteConfig.defaultAuthor.name,
    url: personUrl,
    description: siteConfig.defaultAuthor.bio,
    ...(siteConfig.authorSameAs.length ? { sameAs: siteConfig.authorSameAs } : {}),
  },
];

const breadcrumbJsonLd =
  breadcrumbs && breadcrumbs.length
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbs.map((crumb, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: crumb.name,
          item: absoluteUrl(trailSlash(crumb.path)),
        })),
      }
    : null;

const allJsonLd = [
  ...defaultJsonLd,
  ...(breadcrumbJsonLd ? [breadcrumbJsonLd] : []),
  ...jsonLd,
];

function isCurrent(href: string): boolean {
  const target = trailSlash(href);
  if (target === '/') return pathname === '/';
  return pathname === target || pathname.startsWith(target);
}

const gaId = siteConfig.ga4MeasurementId;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.defaultAuthor.name} />
    <link rel="canonical" href={canonical} />
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'}
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={siteConfig.themeColor} />
    <meta name="apple-mobile-web-app-title" content={siteConfig.brandName} />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-96x96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />

    {siteConfig.googleSiteVerification && (
      <meta name="google-site-verification" content={siteConfig.googleSiteVerification} />
    )}
    {siteConfig.bingSiteVerification && (
      <meta name="msvalidate.01" content={siteConfig.bingSiteVerification} />
    )}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteConfig.siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={siteConfig.locale.replace('_', '-')} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${siteConfig.siteName} — free dog and cat calculators`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageAbs} />
    <meta name="twitter:image:alt" content={`${siteConfig.siteName} — free dog and cat calculators`} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {siteConfig.twitterHandle && (
      <meta name="twitter:site" content={`@${siteConfig.twitterHandle}`} />
    )}

    {
      gaId && (
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          window.gtag = gtag;
          gtag('consent', 'default', {
            ad_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied',
            analytics_storage: 'denied',
            wait_for_update: 500,
          });
          gtag('js', new Date());
          gtag('config', gaId, {
            anonymize_ip: true,
            send_page_view: true,
          });
          window.__petcalcLoadGa = function () {
            if (window.__petcalcGaLoaded) return;
            window.__petcalcGaLoaded = true;
            var s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
            document.head.appendChild(s);
          };
        </script>
      )
    }

    {adsEnabled && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${siteConfig.adsensePublisherId}`}
        crossorigin="anonymous"
      />
    )}

    {allJsonLd.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true">🐾</span>
          <span>{siteConfig.brandName}</span>
        </a>
        <button
          type="button"
          class="nav-toggle"
          data-nav-toggle
          aria-expanded="false"
          aria-controls="site-nav"
        >
          <span class="visually-hidden">Menu</span>
          <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path
              fill="currentColor"
              d="M4 7h16v2H4V7zm0 5h16v2H4v-2zm0 5h16v2H4v-2z"></path>
          </svg>
        </button>
        <nav id="site-nav" class="site-nav" data-site-nav aria-label="Primary">
          {
            navLinks.map((link) => (
              <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main id="main-content" class="main">
      {breadcrumbs && breadcrumbs.length > 0 && <Breadcrumbs items={breadcrumbs} />}
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div>
          <p>
            <strong>{siteConfig.siteName}</strong> — {siteConfig.tagline}
          </p>
          <p class="meta-row">
            <span>Maintained by {siteConfig.defaultAuthor.name}</span>
          </p>
          <p class="meta-row">
            <span>Last updated: {lastUpdated}</span>
          </p>
          <p class="meta-row">
            <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a>
          </p>
        </div>
        <div>
          <h2>Calculators</h2>
          <ul>
            {
              tools.map((tool) => (
                <li>
                  <a href={`/tools/${tool.slug}/`}>{tool.shortTitle}</a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h2>Guides</h2>
          <ul>
            {
              guides.map((guide) => (
                <li>
                  <a href={`/guides/${guide.slug}/`}>{guide.title}</a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h2>Legal &amp; info</h2>
          <ul>
            {
              footerLegal.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <p class="footer-copy meta-row">
        <span>&copy; {new Date().getFullYear()} {siteConfig.siteName}</span>
      </p>
    </footer>

    <div
      class="cookie-banner"
      data-cookie-banner
      data-defer-cookie={deferCookieBanner ? 'true' : 'false'}
      role="dialog"
      aria-label="Cookie notice"
      aria-live="polite"
    >
      <div class="inner">
        <p>
          We use cookies for analytics.
          <span class="cookie-privacy-long"> See our</span>
          <a href="/privacy/">Privacy</a>.
        </p>
        <div class="cookie-actions">
          <button type="button" data-cookie-reject>Reject</button>
          <button type="button" data-cookie-accept>OK</button>
        </div>
      </div>
    </div>

    <script is:inline define:vars={{ deferCookieBanner, hasGa: Boolean(gaId) }}>
      (function () {
        var toggle = document.querySelector('[data-nav-toggle]');
        var nav = document.querySelector('[data-site-nav]');
        if (toggle && nav) {
          toggle.addEventListener('click', function () {
            var open = nav.classList.toggle('open');
            toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
          });
        }

        var storageKey = 'petcalc-cookie-notice';
        var banner = document.querySelector('[data-cookie-banner]');
        var accept = document.querySelector('[data-cookie-accept]');
        var reject = document.querySelector('[data-cookie-reject]');
        var consent = null;
        try {
          consent = localStorage.getItem(storageKey);
        } catch (e) {}

        function grantAnalytics() {
          if (typeof gtag === 'function') {
            gtag('consent', 'update', {
              analytics_storage: 'granted',
            });
          }
          if (typeof window.__petcalcLoadGa === 'function') {
            window.__petcalcLoadGa();
          }
        }

        function denyAnalytics() {
          if (typeof gtag === 'function') {
            gtag('consent', 'update', {
              analytics_storage: 'denied',
              ad_storage: 'denied',
              ad_user_data: 'denied',
              ad_personalization: 'denied',
            });
          }
        }

        function hideBanner() {
          if (banner) banner.classList.remove('show');
        }

        function showBanner() {
          if (banner) banner.classList.add('show');
        }

        function loadGaIdle() {
          if (!hasGa) return;
          var run = function () {
            if (typeof window.__petcalcLoadGa === 'function') window.__petcalcLoadGa();
          };
          if ('requestIdleCallback' in window) {
            requestIdleCallback(run, { timeout: 4000 });
          } else {
            setTimeout(run, 2000);
          }
        }

        if (consent === 'accepted') {
          grantAnalytics();
          loadGaIdle();
        } else if (consent === 'rejected') {
          denyAnalytics();
        } else if (banner) {
          if (deferCookieBanner) {
            var revealed = false;
            var reveal = function () {
              if (revealed) return;
              revealed = true;
              showBanner();
            };
            window.addEventListener('scroll', reveal, { once: true, passive: true });
            document.addEventListener(
              'pointerdown',
              function (ev) {
                if (banner.contains(ev.target)) return;
                reveal();
              },
              { once: true },
            );
          } else {
            showBanner();
          }
        }

        if (accept && banner) {
          accept.addEventListener('click', function () {
            try {
              localStorage.setItem(storageKey, 'accepted');
            } catch (e) {}
            grantAnalytics();
            loadGaIdle();
            hideBanner();
          });
        }
        if (reject && banner) {
          reject.addEventListener('click', function () {
            try {
              localStorage.setItem(storageKey, 'rejected');
            } catch (e) {}
            denyAnalytics();
            hideBanner();
          });
        }

        function track(name, params) {
          if (typeof gtag !== 'function') return;
          try {
            if (localStorage.getItem(storageKey) !== 'accepted') return;
          } catch (e) {
            return;
          }
          gtag('event', name, params || {});
        }

        document.addEventListener('click', function (ev) {
          var t = ev.target;
          if (!(t instanceof Element)) return;
          var tel = t.closest('a[href^="tel:"]');
          if (tel) {
            track('hotline_click', {
              event_category: 'engagement',
              link_url: tel.getAttribute('href') || '',
              hotline: tel.getAttribute('data-tel-hotline') || 'unknown',
            });
            return;
          }
          var ref = t.closest('a[data-ref-link], .sources a[href^="http"], .trust-block a[href^="http"]');
          if (ref && ref.hostname && ref.hostname !== location.hostname) {
            track('outbound_ref_click', {
              event_category: 'engagement',
              link_url: ref.href,
              link_text: (ref.textContent || '').trim().slice(0, 100),
            });
          }
        });

        document.addEventListener('petcalc:calculate', function (ev) {
          var detail = ev.detail || {};
          track('calculation_run', {
            event_category: 'engagement',
            tool_slug: detail.tool || 'unknown',
          });
        });
      })();
    </script>
  </body>
</html>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .footer-copy {
    max-width: var(--max);
    margin: 1.25rem auto 0;
    padding: 0 1rem;
  }
</style>
