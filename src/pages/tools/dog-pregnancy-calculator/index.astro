const faq = [
  {
    q: 'How long is a dog pregnant?',
    a: 'About 63 days from ovulation, with a normal range of roughly 58 to 68 days when counted from the date of breeding, because sperm can survive for several days and the egg needs time to mature after ovulation.',
  },
  {
    q: 'Should I count from the breeding date or the ovulation date?',
    a: 'Ovulation is more precise. If your vet confirmed ovulation with progesterone testing, choose that option for a tighter window. Counting from breeding gives a wider window because ovulation timing is uncertain.',
  },
  {
    q: 'When can a vet confirm that my dog is pregnant?',
    a: 'Ultrasound can detect pregnancy from about day 25 to 28. Abdominal palpation is sometimes possible around day 28 to 30, and X-rays at about day 45 or later can count puppies and check skeletal development.',
  },
  {
    q: 'What are the signs that labor is approaching?',
    a: 'A drop in rectal temperature to below about 99°F (37.2°C) typically precedes labor by 8 to 24 hours. Nesting, restlessness, loss of appetite, and panting are other signs. Call your vet if your dog is straining for more than 30 to 60 minutes without producing a puppy.',
  },
  {
    q: 'When should I call the veterinarian during whelping?',
    a: 'Call right away for green or bloody discharge before the first puppy, more than two hours between puppies with active contractions, weak or absent contractions, or if your dog is past about day 65 from ovulation. Emergency c-sections save lives.',
  },
  {
    q: 'Does this calculator work for cats?',
    a: 'No. This tool is built specifically for dogs and their breeding physiology. Cats ovulate in response to mating and have their own timeline, so ask your vet about feline pregnancy.',
  },
];

const sources = [
  {
    title: 'Concannon PW. Reproductive cycles of the domestic bitch. Animal Reproduction Science 2011;124:200–210',
