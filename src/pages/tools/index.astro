---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { tools } from '../../data/tools.ts';

const title = 'All Pet Calculator Tools';
const description =
  'Browse free dog and cat calculators: puppy weight, food calories, age conversion, chocolate toxicity, water intake, and more.';
const breadcrumbs = [
  { name: 'Tools', path: '/tools/' },
];
---

<BaseLayout title={title} description={description} canonicalPath="/tools/" breadcrumbs={breadcrumbs}>
  <h1>All pet calculator tools</h1>
  <p class="answer-first">
    Every calculator here runs in your browser, works in pounds or kilograms, cites its formula, and needs no
    account. Choose a tool below, or start from the <a href="/dogs/">dog hub</a> or the <a href="/cats/">cat hub</a>.
  </p>
  <div class="card-grid cols-3">
    {
      tools.map((t) => (
        <a class="tool-card" href={`/tools/${t.slug}/`}>
          <h2>{t.title}</h2>
          <p>{t.description}</p>
        </a>
      ))
    }
  </div>

  <div class="prose">
    <h2>Which calculator should I use?</h2>
    <p>
      Match the tool to the question you are trying to answer. If you are deciding how much to feed, start with the
      <a href="/tools/dog-food-calculator/">dog food calculator</a> for adults, the
      <a href="/tools/puppy-food-calculator/">puppy food calculator</a> for growing dogs, or the
      <a href="/tools/cat-food-calculator/">cat food calculator</a> for cats. They all start from resting energy
      requirement and a life-stage multiplier, then turn calories into cups using the number on your food label.
    </p>
    <p>
      If you want to know how big a puppy will get, use the
      <a href="/tools/puppy-weight-calculator/">puppy weight calculator</a>. To judge whether a dog is at a healthy size, use the
      <a href="/tools/dog-bmi-calculator/">body condition helper</a> alongside a hands-on check of the ribs and waist. For age
      questions, the <a href="/tools/dog-age-calculator/">dog age calculator</a> and
      <a href="/tools/cat-age-calculator/">cat age calculator</a> convert calendar years into life stages that are
      useful for planning vet visits.
    </p>
    <h2>Safety and special situations</h2>
    <p>
      The <a href="/tools/dog-chocolate-toxicity-calculator/">chocolate toxicity calculator</a> is a triage aid for the
      moment after a dog eats something it should not, and it never replaces a call to your vet or a poison hotline. The
      <a href="/tools/dog-pregnancy-calculator/">dog pregnancy calculator</a> estimates a whelping window, and the
      <a href="/tools/dog-water-intake-calculator/">water intake calculator</a> gives a baseline for normal drinking. If you cook or feed
      raw, the <a href="/tools/homemade-dog-food-calculator/">homemade dog food calculator</a> sizes portions, but a balanced recipe
      needs a veterinary nutritionist.
    </p>
    <h2>How the calculators work</h2>
    <p>
      Every result is calculated in your browser using formulas documented on our
      <a href="/methodology/">methodology page</a>. Each tool page repeats its equation, shows a worked example, lists common
      mistakes, and cites sources such as the National Research Council, WSAVA, AAHA, AAFP, AAFCO, ASPCA, and the MSD Veterinary Manual.
      Results are estimates for healthy animals and are not veterinary advice.
    </p>
  </div>
</BaseLayout>
