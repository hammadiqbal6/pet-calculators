const faq = [
  {
    q: 'How much water should a dog drink per day?',
    a: 'A common teaching range for healthy adult dogs is about 50 to 60 mL per kilogram of body weight per day, or roughly one ounce per pound. A 20 kg (44 lb) dog would drink about 1.0 to 1.2 liters, which is around four to five cups.',
  },
  {
    q: 'Does dry food change how much a dog drinks?',
    a: 'Yes. Dogs on dry kibble usually drink more than dogs on wet or fresh food, because kibble contains about 10 percent moisture while wet food is around 75 percent. The calculator’s range is for total intake from drinking and food moisture in typical home conditions.',
  },
  {
    q: 'What is excessive thirst in dogs?',
    a: 'Veterinarians often use more than about 100 mL per kg per day as a flag for polydipsia, although individual dogs vary. A sustained increase over several days is a reason to call your vet, even if the number is below that threshold.',
  },
  {
    q: 'Why is my dog suddenly drinking much more?',
    a: 'Causes include diabetes, kidney disease, Cushing’s disease, infections such as pyometra or urinary tract infections, liver disease, and some medications. Hot weather and exercise also matter. Sudden or sustained change deserves a vet visit.',
  },
  {
    q: 'Should I restrict my dog’s water?',
    a: 'Not unless your vet instructs you to. Dogs need constant access to fresh water. Short-term limits for specific medical situations or house training should be done only with veterinary advice.',
  },
  {
    q: 'How do I know if my dog is dehydrated?',
    a: 'Signs include dry or tacky gums, sunken eyes, lethargy, reduced skin elasticity, and thick saliva. Severe dehydration is an emergency. Call a vet if your dog is vomiting, has diarrhea, or refuses to drink.',
  },
];

const sources = [
  SRC.nrc,
  SRC.aahaNutrition,
  SRC.msdPolydipsia,
