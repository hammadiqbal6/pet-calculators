---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig, absoluteUrl, hasConfiguredReviewer } from '../config/site.ts';

const author = siteConfig.defaultAuthor;
const reviewer = siteConfig.reviewer;
const showReviewer = hasConfiguredReviewer(reviewer);

const description =
  'Who builds PetCalc Tools: the PetCalc Team maintains the calculators and guides, with formulas sourced from cited veterinary references.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    name: 'PetCalc Tools authors',
    url: absoluteUrl('/authors/'),
    mainEntity: {
      '@type': 'Organization',
      name: author.name,
      url: absoluteUrl('/about/'),
    },
  },
];
---

<BaseLayout
  title="Authors & Reviewers"
  description={description}
  canonicalPath="/authors/"
  jsonLd={jsonLd}
  breadcrumbs={[{ name: 'Authors', path: '/authors/' }]}
>
  <header class="hero">
    <h1>Authors and reviewers</h1>
    <p class="lead">
      Calculators and guides on {siteConfig.siteName} are maintained by {author.name}. Formulas cite published
      veterinary sources; they are educational tools, not clinical advice.
    </p>
  </header>

  <div class="prose">
    <h2>{author.name}</h2>
    <p><strong>Role:</strong> {author.role}</p>
    <p>{author.bio}</p>
    <p>
      Questions, corrections, or source suggestions:{' '}
      <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a>
      {' '}or the <a href="/contact/">contact page</a>.
    </p>

    <h2>Veterinary review</h2>
    {
      showReviewer ? (
        <>
          <p>
            <strong>{reviewer.name}</strong>, {reviewer.credentials}
          </p>
          {reviewer.note ? <p>{reviewer.note}</p> : null}
        </>
      ) : (
        <p>
          No named veterinary reviewer is credited on these pages yet. Content is checked for accuracy against the
          published sources listed on each page and on the <a href="/methodology/">methodology</a> page. Licensed
          veterinarians who want to review a page are welcome to get in touch.
        </p>
      )
    }

    <h2>Editorial standards</h2>
    <ul>
      <li>Every formula is traced to a published source and listed on the <a href="/methodology/">methodology</a> page.</li>
      <li>Health claims are cited to organizations such as AAFCO, WSAVA, AAHA, AAFP, ASPCA, and the MSD Veterinary Manual.</li>
      <li>Pages carry a visible last-updated date, and material corrections are logged with a new date.</li>
      <li>Authors and reviewers disclose any commercial relationship with pet-product companies. At launch there are none.</li>
    </ul>

    <h2>Become a reviewer</h2>
    <p>
      Licensed veterinarians, veterinary technicians, and board-certified nutritionists who would like to review pages
      can reach us at <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a> or through the{' '}
      <a href="/contact/">contact page</a>. Reviewers are credited by name on the pages they check.
    </p>
  </div>
</BaseLayout>
