---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig, absoluteUrl } from '../config/site.ts';

const description =
  'Meet the PetCalc Tools editorial team and learn how veterinary reviewers are credited on calculators and guides across the site.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    name: 'PetCalc Tools authors',
    url: absoluteUrl('/authors/'),
    mainEntity: {
      '@type': 'Organization',
      name: siteConfig.defaultAuthor.name,
      url: absoluteUrl('/about/'),
    },
  },
];
---

<BaseLayout
  title="Authors & Reviewers"
  description={description}
  canonicalPath="/authors/"
  jsonLd={jsonLd}
  breadcrumbs={[{ name: 'Authors', path: '/authors/' }]}
>
  <header class="hero">
    <h1>Authors and reviewers</h1>
    <p class="lead">
      Calculators and guides on {siteConfig.siteName} are written by our editorial team and are intended to be reviewed
      by credentialed veterinary professionals. This page explains who is responsible for what.
    </p>
  </header>

  <div class="prose">
    <h2>{siteConfig.defaultAuthor.name}</h2>
    <p><strong>Role:</strong> {siteConfig.defaultAuthor.role}</p>
    <p>
      The editorial team researches published veterinary guidelines, translates formulas into working calculators, writes
      the explanations, and checks every number against a cited source. The team's background is in science writing and
      software, not clinical practice, which is why we cite primary guidance throughout and ask for professional review.
      [Author bio placeholder: add editor names, relevant experience, and a headshot here before launch.]
    </p>

    <h2>Veterinary reviewer</h2>
    <p>
      <strong>{siteConfig.reviewerPlaceholder.name}</strong>, {siteConfig.reviewerPlaceholder.credentials}
    </p>
    <p>
      [Reviewer bio placeholder: add the reviewer's name, licensure, clinic or institution, areas of focus, and the pages they have reviewed.]
      {siteConfig.reviewerPlaceholder.note}
    </p>

    <h2>Editorial standards</h2>
    <ul>
      <li>Every formula is traced to a published source and listed on the <a href="/methodology/">methodology</a> page.</li>
      <li>Health claims are cited to organizations such as AAFCO, WSAVA, AAHA, AAFP, ASPCA, and the MSD Veterinary Manual.</li>
      <li>Pages carry a visible last-updated date, and material corrections are logged with a new date.</li>
      <li>Authors and reviewers disclose any commercial relationship with pet-product companies. At launch there are none.</li>
    </ul>

    <h2>Become a reviewer</h2>
    <p>
      Licensed veterinarians, veterinary technicians, and board-certified nutritionists who would like to review pages
      can reach us through the <a href="/contact/">contact page</a>. Reviewers are credited by name on the pages they check.
    </p>
  </div>
</BaseLayout>
