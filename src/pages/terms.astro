---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site.ts';

const description =
  'Terms of use for PetCalc Tools: educational calculators, no veterinary advice, acceptable use, intellectual property, and limits of liability.';
---

<BaseLayout
  title="Terms of Use for PetCalc Tools"
  description={description}
  canonicalPath="/terms/"
  breadcrumbs={[{ name: 'Terms of Use', path: '/terms/' }]}
>
  <header class="hero">
    <h1>Terms of use</h1>
    <p class="lead">
      By using {siteConfig.siteName} you agree to these terms. The short version: the tools are free and educational,
      they are not veterinary advice, and you use them at your own risk.
    </p>
    <p class="meta-row"><span>Last updated: {siteConfig.buildDate}</span></p>
  </header>

  <div class="prose">
    <h2>1. Educational use only</h2>
    <p>
      The calculators, guides, tables, and other content on this site are provided for general information. They are
      not veterinary advice, diagnosis, or treatment, and they do not create a veterinarian-client-patient
      relationship. Results are estimates based on published formulas and averages. Your animal may need more or less
      than a calculator suggests. Always consult a licensed veterinarian about feeding, medication, toxic exposures,
      breeding, weight management, and any health concern.
    </p>

    <h2>2. Emergencies</h2>
    <p>
      Do not use this site to decide whether a pet needs urgent care. If you suspect poisoning, injury, or serious
      illness, contact a veterinarian, an emergency clinic, or an animal poison control service immediately. A calculator
      that returns a "low" result does not mean an exposure is safe.
    </p>

    <h2>3. Accuracy and availability</h2>
    <p>
      We work to keep formulas and references current, but we make no warranty that content is complete, accurate, or
      suitable for a particular animal. The site is provided "as is" and "as available". We may change, suspend, or
      remove any tool or page at any time without notice.
    </p>

    <h2>4. Acceptable use</h2>
    <ul>
      <li>Do not scrape the site at a rate that degrades service or attempt to disrupt or probe it for vulnerabilities.</li>
      <li>Do not present our results as veterinary advice to others, or use them to replace professional care.</li>
      <li>Do not copy the site's text wholesale for republication. Short quotations with attribution and a link are fine.</li>
      <li>Do not use the embeddable calculators in a way that removes the credit link or misrepresents who built them.</li>
    </ul>

    <h2>5. Embeds</h2>
    <p>
      The embeddable calculators may be placed on other sites free of charge as long as the credit link back to
      {siteConfig.siteName} remains visible and the embed is not altered to change calculations. We may disable embeds at any time.
    </p>

    <h2>6. Intellectual property</h2>
    <p>
      Site text, design, and code are owned by {siteConfig.siteName} or its licensors. Underlying scientific facts,
      published equations, and the guidelines we cite belong to their respective authors and organizations. Trademarks
      of AAFCO, WSAVA, AAHA, AAFP, ASPCA, and others belong to their owners, and citing them does not imply endorsement of this site.
    </p>

    <h2>7. Third-party links, advertising, and analytics</h2>
    <p>
      The site links to outside sources and may display advertising from third parties such as Google AdSense. We do not
      control third-party content and are not responsible for it or for products or services you obtain through it.
      See the <a href="/privacy/">privacy policy</a> for how advertising and analytics cookies work.
    </p>

    <h2>8. Limitation of liability</h2>
    <p>
      To the fullest extent permitted by law, {siteConfig.siteName} and its operators are not liable for any indirect,
      incidental, consequential, or special damages, or for injury or loss to any animal, arising from your use of or inability to use
      the site or reliance on its content. Where liability cannot be excluded, it is limited to the greatest extent the law allows.
    </p>

    <h2>9. Changes to these terms</h2>
    <p>
      We may update these terms from time to time. The date above shows the latest revision, and continued use of the
      site after a change means you accept it.
    </p>

    <h2>10. Contact</h2>
    <p>
      Questions about these terms can be sent to <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a>{' '}
      or through the <a href="/contact/">contact page</a>.
    </p>
  </div>
</BaseLayout>
