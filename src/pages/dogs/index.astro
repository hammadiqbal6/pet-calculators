---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { tools } from '../../data/tools.ts';
import { guides } from '../../data/guides.ts';

const dogTools = tools.filter((t) => t.category === 'dog' || t.category === 'both');
const dogGuides = guides.filter((g) =>
  g.relatedTools.some((slug) => dogTools.some((t) => t.slug === slug)),
);

const title = 'Dog Calculators: Food, Weight, Age & Health';
const description =
  'Free dog calculators for puppy weight, daily food calories, age by size, pregnancy due date, chocolate toxicity, water intake and body condition.';
const breadcrumbs = [
  { name: 'Dogs', path: '/dogs/' },
];
---

<BaseLayout title={title} description={description} canonicalPath="/dogs/" breadcrumbs={breadcrumbs}>
  <h1>Dog calculators</h1>
  <p class="answer-first">
    This hub collects every dog-focused calculator on the site—growth, feeding, age, pregnancy,
    toxicity, hydration, and body condition—plus guides that answer the questions owners search for
    next. Start with a tool, then read the linked formula and sources on each page.
  </p>

  <div class="prose">
    <h2>Growing, feeding, and caring for a dog</h2>
    <p>
      Most dog questions follow the same arc. A puppy arrives and you want to know how big it will get, which the{' '}
      <a href="/tools/puppy-weight-calculator/">puppy weight calculator</a> estimates from age, weight, and breed
      size. You then need a feeding plan: the <a href="/tools/puppy-food-calculator/">puppy food calculator</a> applies
      growth multipliers of two to three times resting energy, and once your dog is an adult the{' '}
      <a href="/tools/dog-food-calculator/">dog food calculator</a> switches to maintenance factors. Our guides on{' '}
      <a href="/guides/when-do-puppies-stop-growing/">when puppies stop growing</a> and{' '}
      <a href="/guides/how-much-to-feed-a-puppy/">how much to feed a puppy</a> explain the reasoning in plain language.
    </p>
    <p>
      Dogs mature at different speeds. Toy breeds reach adult size around 10 months, while giant breeds can keep growing
      for two years, which is why age conversion depends on size. The{' '}
      <a href="/tools/dog-age-calculator/">dog age calculator</a> replaces the outdated seven-to-one rule with a size-aware model, and the{' '}
      <a href="/guides/dog-years-myth/">dog years myth</a> guide explains why. To check that your dog stays lean through
      adulthood, pair the <a href="/tools/dog-bmi-calculator/">body condition helper</a> with regular weigh-ins and the{' '}
      <a href="/tools/dog-water-intake-calculator/">water intake calculator</a> for a drinking baseline.
    </p>
    <p>
      Some situations are time-sensitive. If a dog eats chocolate, call a vet first, then use the{' '}
      <a href="/tools/dog-chocolate-toxicity-calculator/">chocolate toxicity calculator</a> and the{' '}
      <a href="/guides/chocolate-and-dogs-safety/">chocolate safety guide</a> to understand the dose. If you are
      breeding, the <a href="/tools/dog-pregnancy-calculator/">pregnancy calculator</a> gives a due date window to discuss with your
      veterinarian. For owners who prepare meals at home, the{' '}
      <a href="/tools/homemade-dog-food-calculator/">homemade dog food calculator</a> and the{' '}
      <a href="/guides/raw-feeding-basics/">raw feeding basics</a> guide cover portions and the nutritional risks of unbalanced recipes.
    </p>
    <p>
      Every dog is an individual. Use these results as a starting point, check body condition regularly, and let your
      veterinarian make the final call. See the <a href="/methodology/">methodology</a> for the formulas and sources.
    </p>
  </div>

  <h2>Dog tools</h2>
  <div class="card-grid cols-3">
    {
      dogTools.map((t) => (
        <a class="tool-card" href={`/tools/${t.slug}/`}>
          <h3>{t.title}</h3>
          <p>{t.description}</p>
        </a>
      ))
    }
  </div>

  <h2 style="margin-top: 2rem">Related guides</h2>
  <div class="card-grid">
    {
      dogGuides.map((g) => (
        <a class="tool-card" href={`/guides/${g.slug}/`}>
          <h3>{g.title}</h3>
          <p>{g.description}</p>
        </a>
      ))
    }
  </div>
</BaseLayout>
