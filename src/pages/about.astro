---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig, absoluteUrl, hasConfiguredReviewer } from '../config/site.ts';
import { sisterSites } from '../config/sisterSites.ts';
import { tools } from '../data/tools.ts';
import { guides } from '../data/guides.ts';

const author = siteConfig.defaultAuthor;
const reviewer = siteConfig.reviewer;
const showReviewer = hasConfiguredReviewer(reviewer);

const description =
  'About PetCalc Tools: free dog and cat calculators built by Hammad Iqbal, with cited veterinary sources, honest limits, and no invented credentials.';

/** Other sister sites (exclude this repo); URLs from PUBLIC_SITE_URL_* env. */
const otherSites = sisterSites.filter((s) => s.key !== 'pet');

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    dateModified: `${siteConfig.buildDate}T00:00:00+00:00`,
    mainEntity: {
      '@type': 'Person',
      '@id': siteConfig.personId,
      name: author.name,
      description: author.bio,
      url: absoluteUrl('/about/'),
      knowsAbout: [
        'pet calculators',
        'dog nutrition formulas',
        'veterinary reference tooling',
      ],
      sameAs: siteConfig.authorSameAs,
    },
  },
];
---

<BaseLayout
  title="About PetCalc Tools: Free Dog & Cat Calculators"
  description={description}
  canonicalPath="/about/"
  jsonLd={jsonLd}
  breadcrumbs={[{ name: 'About', path: '/about/' }]}
>
  <header class="hero">
    <h1>About {siteConfig.siteName}</h1>
    <p class="lead">
      {siteConfig.siteName} is a free set of dog and cat calculators, built and maintained by one person: me,{' '}
      {author.name}.
    </p>
  </header>

  <div class="prose">
    <h2 id="maintainer">Why I built it</h2>
    <p>
      Everyday pet questions — how much to feed, how big a puppy will get, how old a dog is in human years, whether
      chocolate is an emergency — often land on ad-heavy pages with vague rules of thumb. I wanted a site that answers
      first, shows the formula, cites the veterinary sources, and keeps your inputs in your browser.
    </p>

    <h2>Who I am</h2>
    <p>{author.bio}</p>
    <p>
      Find me on{' '}
      <a href="https://github.com/hammadiqbal6" rel="noopener noreferrer">GitHub</a>
      {' '}or email{' '}
      <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a>.
    </p>

    <h2>How the tools are made</h2>
    <p>
      Every tool lists its formula and its sources on the page. Sources are primary guidance from organizations such as
      AAHA, WSAVA, AAFCO, AAFP, the NRC, ASPCA Animal Poison Control, Pet Poison Helpline, and the Merck / MSD Veterinary
      Manual, plus peer-reviewed research where we cite a specific equation (for example Wang et al. 2020 on dog aging,
      based on 104 Labrador Retrievers — not “~300”). Each page shows the date I last checked it against those sources.
      Full details: <a href="/methodology/">Methodology</a>.
    </p>
    <p>
      There are {tools.length} calculators and {guides.length} guides. Browse the{' '}
      <a href="/tools/">calculator list</a>, the <a href="/dogs/">dog hub</a>, the <a href="/cats/">cat hub</a>, or the{' '}
      <a href="/guides/">guides</a>.
    </p>

    <h2>Veterinary review</h2>
    {
      showReviewer ? (
        <>
          <p>
            <strong>{reviewer.name}</strong>, {reviewer.credentials}
          </p>
          {reviewer.note ? <p>{reviewer.note}</p> : null}
        </>
      ) : (
        <p>
          No named veterinary reviewer is credited on these pages yet. I check content against the published sources
          listed on each page. I do not invent “reviewed by” credits. Licensed veterinarians who want to review a page
          are welcome to get in touch — you will be named only on pages you actually review.
        </p>
      )
    }

    <h2>What this site doesn&apos;t do</h2>
    <ul>
      <li>It does not give veterinary advice. Results are estimates and starting points.</li>
      <li>
        Calculator inputs stay in your browser. Optional analytics (GA4) loads only after you accept cookies; see the{' '}
        <a href="/privacy/">privacy policy</a>.
      </li>
      <li>It is not affiliated with AAHA, WSAVA, ASPCA, Pet Poison Helpline, or any pet-food brand.</li>
    </ul>

    <h2>How the site is funded</h2>
    <p>
      The plan is Google AdSense once the site meets their content and consent requirements. Ads are off until a publisher
      ID is configured. There are no affiliate product recommendations on emergency or toxin pages.
    </p>

    <h2>Found a mistake?</h2>
    <p>
      Email <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a> with the page, the number that
      looks wrong, and a link to the source that shows the right one. Confirmed fixes are listed in the{' '}
      <a href="/methodology/#changelog">correction log</a>.
    </p>

    <h2>Other free tool sites by {author.name}</h2>
    <p>
      I also maintain a few other free calculator sites. This list lives only here — not in every footer — so it stays
      honest and sparse:
    </p>
    <ul>
      {
        otherSites.map((s) => (
          <li>
            <a href={`${s.origin}${s.path === '/' ? '/' : s.path}`} rel="noopener noreferrer">
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
