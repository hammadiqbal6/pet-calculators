# Every env var read by this repo (import.meta.env / process.env).
# Copy to `.env` for local builds (gitignored). Workers Builds sets the PUBLIC_* /
# INDEXNOW_* names in the dashboard. No secrets — this is a static site.

# --- Site build (Cloudflare Workers Builds) ---

# Canonical origin baked into canonicals, og:url, JSON-LD, sitemap, robots.txt, llms.txt.
PUBLIC_SITE_URL=https://pet-calculators.hammadiqbal117.workers.dev

# Sister tool sites (same names on all five repos). Switch to custom domains without code changes.
# Read via src/config/sisterSites.ts (import.meta.env) with workers.dev fallbacks if unset.
PUBLIC_SITE_URL_PAYMENT_FEES=https://payment-fee-calculators.hammadiqbal117.workers.dev
PUBLIC_SITE_URL_BUSINESS_DOCS=https://business-document-generators.hammadiqbal117.workers.dev
PUBLIC_SITE_URL_HOME_GARDEN=https://home-garden-calculators.hammadiqbal117.workers.dev
PUBLIC_SITE_URL_FIBER_ARTS=https://fiber-arts-calculators.hammadiqbal117.workers.dev
PUBLIC_SITE_URL_PET=https://pet-calculators.hammadiqbal117.workers.dev

# Google Analytics 4 measurement ID; empty disables all analytics script tags.
# Loaded after idle/interaction with Consent Mode v2 defaults (denied until OK).
PUBLIC_GA4_MEASUREMENT_ID=G-32E2E1201X

# Google Search Console HTML-tag verification `content` value; empty omits the meta tag.
PUBLIC_GSC_VERIFICATION=0-q_NxhBgfgCm4WOLfbe9VrHrjbLzaxh8SXsbo2Q-UU

# Bing Webmaster Tools HTML-tag verification `content` value; empty omits the meta tag.
PUBLIC_BING_SITE_VERIFICATION=

# Public contact mailbox for Contact/privacy/terms, footer, and Organization JSON-LD.
PUBLIC_CONTACT_EMAIL=hammadiqbal117@gmail.com

# EmailJS contact form (FREE plan). All three required or /contact/ falls back to mailto only.
# Public key only — never put the EmailJS private key in the repo or Workers env.
# See docs/CONTACT-EMAILJS.md for template variables.
PUBLIC_EMAILJS_SERVICE_ID=
PUBLIC_EMAILJS_TEMPLATE_ID=
PUBLIC_EMAILJS_PUBLIC_KEY=

# AdSense publisher ID (ca-pub-…); leave empty until approved — no ad code ships while empty.
PUBLIC_ADSENSE_PUBLISHER_ID=

# Set to true/1 only after AdSense approval if you enable Auto ads (requires publisher ID).
PUBLIC_ADSENSE_AUTO_ADS=

# Author byline name (defaults to "Hammad Iqbal" when unset).
PUBLIC_AUTHOR_NAME=Hammad Iqbal

# Author role label shown next to the byline (defaults to "Site maintainer").
PUBLIC_AUTHOR_ROLE=Site maintainer

# Author bio on /about/ (honest maintainer text; never invent veterinary credentials).
PUBLIC_AUTHOR_BIO=I build and maintain PetCalc Tools as an independent developer. Formulas are implemented from cited veterinary references (NRC, AAHA, WSAVA, AAFCO, AAFP, ASPCA, and the Merck / MSD Veterinary Manual), explained in plain language, and checked against the published numbers in those sources. I am not a veterinarian; clinical decisions always belong with a licensed professional and the individual animal.

# Named veterinary reviewer — leave empty until a real credentialed reviewer is configured.
PUBLIC_REVIEWER_NAME=

# Reviewer credentials (e.g. DVM); required together with PUBLIC_REVIEWER_NAME or both are ignored.
PUBLIC_REVIEWER_CREDENTIALS=

# Optional note under the reviewer byline when a real reviewer is set.
PUBLIC_REVIEWER_NOTE=

# IndexNow API key (must match public/{key}.txt); used by siteConfig and scripts/indexnow.mjs.
INDEXNOW_KEY=6a232080046a9576fef903fc8f5b8279

# Set to 1 to skip the post-deploy IndexNow POST (useful for preview deploys).
INDEXNOW_DISABLE=

# --- Local / CI tooling (not required on Cloudflare Builds) ---

# Override dist/ path for audit scripts (default: ./dist).
AUDIT_DIST=

# Set to 1 so placeholder-domain / reviewer-placeholder / IndexNow launch blockers fail the audit.
AUDIT_PROD=

# Set to 1 (or pass --strict) so audit warnings are treated as errors.
AUDIT_STRICT=

# Gzip JS budget per content page in KB for audit:budgets (default 25).
BUDGET_PAGE_JS_KB=

# Gzip JS budget per embed page in KB (default 15).
BUDGET_EMBED_JS_KB=

# Gzip budget for any single emitted .js file in KB (default 20).
BUDGET_SINGLE_JS_KB=

# Gzip budget for all .js in dist/ in KB (default 200).
BUDGET_TOTAL_JS_KB=

# Gzip HTML document budget in KB including inlined CSS (default 60).
BUDGET_PAGE_HTML_KB=

# Gzip CSS budget in KB (default 25).
BUDGET_CSS_KB=

# Raw size budget for any single image in KB (default 150).
BUDGET_IMAGE_KB=

# Gzip budget for one inline script in KB (default 6).
BUDGET_INLINE_SCRIPT_KB=

# Base URL for scripts/capture-screenshots.mjs (default http://127.0.0.1:4321).
PREVIEW_URL=

# Local port for npm run proof static server (default 4321).
PROOF_PORT=

# Per-page script transfer budget in KB for proof generation (default 50).
PROOF_JS_BUDGET_KB=
