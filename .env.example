# Build-time env vars read by Astro / `src/config/site.ts`.
# Copy to `.env` for local builds. Workers Builds sets these in the dashboard.
# Empty values are fine for local work; no secrets belong here (static site).

# Canonical site origin baked into canonicals, og:url, JSON-LD, sitemap, robots.txt, and llms.txt.
# Required for production deploys. Optional locally (falls back to https://www.petcalctools.example).
# Format: https origin, no trailing slash. Example: https://pet-calculators.hammadiqbal117.workers.dev
PUBLIC_SITE_URL=

# Google Analytics 4 measurement ID. Optional — leave empty to emit no analytics code at all.
# Format: G- followed by alphanumerics. Example: G-XXXXXXXXXX
PUBLIC_GA4_MEASUREMENT_ID=

# Google Search Console HTML-tag verification token. Optional — leave empty to omit the meta tag.
# Value is the `content` attribute of <meta name="google-site-verification" content="...">.
# Prefer DNS verification when you control the zone; this env is for the HTML-tag method.
PUBLIC_GSC_VERIFICATION=

# Public contact mailbox baked into Contact/privacy/terms, the footer, and Organization JSON-LD.
# Optional — leave empty to use the default in src/config/site.ts (hammadiqbal117@gmail.com).
# Format: a real monitored email address.
PUBLIC_CONTACT_EMAIL=
